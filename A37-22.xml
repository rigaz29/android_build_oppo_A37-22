  <project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep"
           remote="gh" revision="lineage-22.2" />

  <!-- ================================================================
       TIDAK ADA DI SINI, DAN ITU DISENGAJA
       ================================================================
       system/tools/dtbtool - LOS 21 mengambilnya dari LineageOS-UL. Tidak ada
       penerus 22.x di mana pun (LineageOS resmi bahkan tidak punya branch 21).
       Ternyata TIDAK DIBUTUHKAN: TARGET_CUSTOM_DTBTOOL := dtbToolOppo

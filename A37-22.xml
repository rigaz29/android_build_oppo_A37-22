<!--
  Local manifest - LineageOS 22.2 (Android 15, SDK 35) untuk OPPO A37 / A37f / A37fw.

  Basis: LineageOS/android lineage-22.2 - OFFICIAL.

      repo init -u https://github.com/LineageOS/android.git -b lineage-22.2

  BUKAN LineageOS-UL: org itu tidak punya branch di atas lineage-21.0
  (diperiksa: lineage-19.1, lineage-20.0, lineage-21.0 saja).

  Penerus UL untuk 22/23 adalah org Ultra-Legacy-Hippeastrum, dan modelnya
  BERBEDA: bukan manifest pengganti, melainkan fork per-repo yang dipasang
  lewat berkas ini. Patch legacy tambahan datang dari MisterZtr/LineageOS_gsi
  branch lineage-22.2 (193 patch), BUKAN dari ULH/legacy_support_patches yang
  hanya punya branch lineage-23.2.

  Lihat PLAN-LOS22.md untuk alasan tiap baris.
-->
<manifest>

  <remote name="gh"  fetch="https://github.com/" />
  <remote name="ulh" fetch="https://github.com/Ultra-Legacy-Hippeastrum/" />

  <!-- ================================================================
       A37: device tree, kernel, vendor
       ================================================================
       Device tree branch lineage-22 DICABANGKAN DARI lineage-21, bukan dari
       lineage-20. lineage-21 sudah membawa perbaikan yang harganya sudah
       dibayar: APEX tak terkompres, ro.hardware.egl, packaging HAL Bluetooth,
       ramoops lengkap, bootwatchdog dengan pengecualian odsign.

       Kernel branch lineage-22 dari lineage-20 (lineage-21 hanya +2 commit).
       Satu-satunya perubahan WAJIB adalah spoof utsname - PLAN-LOS22.md W-1. -->

  <project name="rigaz29/rb_device_oppo_A37" path="device/oppo/A37"
           remote="gh" revision="refs/heads/lineage-22" upstream="lineage-22" />

  <project name="rigaz29/kernel_oppo_msm8939" path="kernel/oppo/msm8939"
           remote="gh" revision="refs/heads/lineage-22" upstream="lineage-22" />

  <project name="rigaz29/rb-vendor_oppo_A37" path="vendor/oppo"
           remote="gh" revision="2e5c6f7ffcccbbf1430f8fa13fc530e1cae5feab"
           upstream="lineage-18.1" />

  <!-- ================================================================
       Fork Ultra-Legacy-Hippeastrum branch lineage-22.2
       ================================================================
       Yang paling menentukan: frameworks/native. Fork ULH masih memiliki
       libs/renderengine/gl/GLESRenderEngine.cpp; LineageOS resmi 22.2 TIDAK
       (HTTP 404). Tanpa itu Adreno 306 dipaksa ke Skia.

       Gerbang verifikasi setelah repo sync:
         test -f frameworks/native/libs/renderengine/gl/GLESRenderEngine.cpp -->

  <remove-project name="LineageOS/android_frameworks_native" />
  <project name="android_frameworks_native" path="frameworks/native"
           remote="ulh" revision="lineage-22.2" groups="pdk" />

  <remove-project name="LineageOS/android_frameworks_base" />
  <project name="android_frameworks_base" path="frameworks/base"
           remote="ulh" revision="lineage-22.2"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" />

  <remove-project name="LineageOS/android_system_core" />
  <project name="android_system_core" path="system/core"
           remote="ulh" revision="lineage-22.2" groups="pdk" />

  <remove-project name="LineageOS/android_bionic" />
  <project name="android_bionic" path="bionic"
           remote="ulh" revision="lineage-22.2" groups="pdk" />

  <remove-project name="LineageOS/android_system_sepolicy" />
  <project name="android_system_sepolicy" path="system/sepolicy"
           remote="ulh" revision="lineage-22.2" groups="pdk" />

  <!-- PERHATIAN: project ini WAJIB membawa seluruh <linkfile> milik entri resmi.
       Repo memperlakukan linkfile sebagai anak dari entri project, jadi
       remove-project + tambah-ulang MENGHAPUS semuanya.

       Berkas yang ditaut adalah os_pickup*.bp/mk, dan os_pickup.bp isinya
       persis `soong_namespace {}` (20 byte). Tanpa taut itu, SETIAP pohon
       hardware/qcom-caf/<soc> kehilangan namespace-nya dan seluruh modulnya
       jatuh ke namespace global. Karena nama modul qcom-caf diturunkan dari
       TARGET_BOARD_PLATFORM (audio.primary.$(PLATFORM), gralloc.$(PLATFORM)),
       membangun untuk msm8916 membuat SEMUA pohon SoC menghasilkan nama yang
       sama dan bertabrakan.

       Diukur: menghilangkannya menghasilkan 443 galat "module already defined"
       di 12 pohon SoC, dan soong bootstrap gagal sebelum analisis dimulai.

       Daftar ini disalin dari snippets/lineage.xml manifest lineage-22.2
       (22 taut). SENGAJA TIDAK ada taut untuk hardware/qcom-caf/msm8916:
       manifest LOS 21 yang terbukti build juga tidak punya, jadi direktori itu
       memang tidak menuntut soong_namespace meski disebut di
       PRODUCT_SOONG_NAMESPACES.

       Kalau LineageOS menambah SoC baru di 22.2, daftar ini harus disamakan:
         diff <(sed -n 's/.*linkfile src="\([^"]*\)" dest="\([^"]*\)".*/\1 \2/p' \
                  .repo/manifests/snippets/lineage.xml) ... -->
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project name="android_hardware_qcom-caf_common" path="hardware/qcom-caf/common"
           remote="ulh" revision="lineage-22.2" groups="qcom">
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8996/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8996/Android.mk" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8150/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8250/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8350/Android.mk" />
    <linkfile src="os_pickup_audio-ar.mk" dest="hardware/qcom-caf/sm8450/audio/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_audio-ar.mk" dest="hardware/qcom-caf/sm8550/audio/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_audio-ar.mk" dest="hardware/qcom-caf/sm8650/audio/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_audio-ar.mk" dest="hardware/qcom-caf/sm8750/audio/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
  </project>

  <remove-project name="LineageOS/android_system_libhidl" />
  <project name="android_system_libhidl" path="system/libhidl"
           remote="ulh" revision="lineage-22.2" groups="pdk,sysui-studio" />

  <!-- Di manifest resmi ini repo AOSP (platform/system/libhwbinder,
       remote aosp), bukan LineageOS. Nama pada remove-project harus persis. -->
  <remove-project name="platform/system/libhwbinder" />
  <project name="android_system_libhwbinder" path="system/libhwbinder"
           remote="ulh" revision="lineage-22.2" groups="pdk" />

  <remove-project name="LineageOS/android_hardware_ril" />

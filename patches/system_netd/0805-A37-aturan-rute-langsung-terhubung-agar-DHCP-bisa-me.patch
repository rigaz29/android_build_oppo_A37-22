From e7d726ebf859267472ebe1715cfa6ec5e6930f42 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Sun, 16 Aug 2026 13:40:38 +0000
Subject: [PATCH] A37: aturan rute langsung-terhubung agar DHCP bisa memasang
 rute

Wi-Fi mentok di 'obtaining IP address' padahal DHCP SUKSES. report/wifi:
lease sah 192.168.0.196 gw 192.168.0.1, lalu 20 milidetik setelah netd memasang
alamatnya ConnectivityService gagal dua kali dengan 'Machine is not on the
network' (ENONET), DNS jadi kosong, dan 18 detik kemudian framework memutus
sendiri (locally_generated=1).

Rute lewat gateway menuntut adanya rute langsung-terhubung yang mencakup gateway
itu. Kernel membuatnya di tabel main, sementara netd bekerja di tabel
per-jaringan; patch menambahkan aturan yang menoleh ke main pada prioritas 30000.
Diambil dari kit LOS 21 dan terap bersih.

Define dipasang langsung sebagai cppflags pada libnetd_server, bukan lewat
soong_config_module_type seperti kit aslinya, karena idiom lineageGlobalVars
sudah dicabut hulu di 22. Terverifikasi ada di cFlags seluruh varian
libnetd_server di build.lineage_A37.7.ninja.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Change-Id: I4174fb05f523ca1fb42e76b7ec819be993787cdf
---
 server/Android.bp          | 14 ++++++++++++++
 server/RouteController.cpp | 23 +++++++++++++++++++++++
 server/RouteController.h   |  3 +++
 3 files changed, 40 insertions(+)

diff --git a/server/Android.bp b/server/Android.bp
index e77554b0..d7648d6e 100644
--- a/server/Android.bp
+++ b/server/Android.bp
@@ -38,6 +38,20 @@ filegroup {
 // Modules common to both netd and netd_unit_test
 cc_library_static {
     name: "libnetd_server",
+    // A37: rute langsung-terhubung.
+    //
+    // Tanpa ini Wi-Fi mentok di "obtaining IP address" padahal DHCP SUKSES.
+    // report/wifi: lease sah (192.168.0.196, gw 192.168.0.1) lalu 20 milidetik
+    // kemudian "addRoute for gateway: Machine is not on the network". Rute lewat
+    // gateway menuntut rute langsung-terhubung yang mencakup gateway itu; kernel
+    // membuatnya di tabel `main`, sementara netd bekerja di tabel per-jaringan.
+    //
+    // Dipasang langsung, BUKAN lewat soong_config_module_type seperti kit LOS 21.
+    // Jalur itu sudah dicoba dan GAGAL DIAM-DIAM di pohon 22: variabelnya terdaftar
+    // dan tipenya bool, defaults-nya terpasang pada modul yang benar, tapi cppflags
+    // tidak pernah sampai ke compiler dan #ifdef-nya hilang tanpa satu pun peringatan.
+    // Build tetap hijau, jadi kegagalannya hanya terlihat dengan memeriksa ninja.
+    cppflags: ["-DNEEDS_NETD_DIRECT_CONNECT_RULE"],
     defaults: [
         "netd_aidl_interface_lateststable_cpp_shared",
         "netd_defaults",
diff --git a/server/RouteController.cpp b/server/RouteController.cpp
index e1ff4695..43040dde 100644
--- a/server/RouteController.cpp
+++ b/server/RouteController.cpp
@@ -802,6 +802,24 @@ int RouteController::configureDummyNetwork() {
     return 0;
 }
 
+#ifdef NEEDS_NETD_DIRECT_CONNECT_RULE
+// Add a new rule to look up the 'main' table, with the same selectors as the "default network"
+// rule, but with a lower priority. We will never create routes in the main table; it should only be
+// used for directly-connected routes implicitly created by the kernel when adding IP addresses.
+// This is necessary, for example, when adding a route through a directly-connected gateway: in
+// order to add the route, there must already be a directly-connected route that covers the gateway.
+[[nodiscard]] int addDirectlyConnectedRule() {
+    Fwmark fwmark;
+    Fwmark mask;
+
+    fwmark.netId = NETID_UNSET;
+    mask.netId = FWMARK_NET_ID_MASK;
+
+    return modifyIpRule(RTM_NEWRULE, RULE_PRIORITY_DIRECTLY_CONNECTED, RT_TABLE_MAIN,
+                        fwmark.intValue, mask.intValue, IIF_NONE, OIF_NONE, UID_ROOT, UID_ROOT);
+}
+#endif
+
 // Add an explicit unreachable rule close to the end of the prioriy list to make it clear that
 // relying on the kernel-default "from all lookup main" rule at priority 32766 is not intended
 // behaviour. We do flush the kernel-default rules at startup, but having an explicit unreachable
@@ -1274,6 +1292,11 @@ int RouteController::Init(unsigned localNetId) {
     if (int ret = addLocalNetworkRules(localNetId)) {
         return ret;
     }
+#ifdef NEEDS_NETD_DIRECT_CONNECT_RULE
+    if (int ret = addDirectlyConnectedRule()) {
+        return ret;
+    }
+#endif
     if (int ret = addUnreachableRule()) {
         return ret;
     }
diff --git a/server/RouteController.h b/server/RouteController.h
index a56d4e05..9b0cd326 100644
--- a/server/RouteController.h
+++ b/server/RouteController.h
@@ -83,6 +83,9 @@ constexpr int32_t RULE_PRIORITY_UID_DEFAULT_NETWORK               = 29000;
 constexpr int32_t RULE_PRIORITY_UID_DEFAULT_UNREACHABLE           = 30000;
 constexpr int32_t RULE_PRIORITY_DEFAULT_NETWORK                   = 31000;
 constexpr int32_t RULE_PRIORITY_UNREACHABLE                       = 32000;
+#ifdef NEEDS_NETD_DIRECT_CONNECT_RULE
+const uint32_t RULE_PRIORITY_DIRECTLY_CONNECTED      = 30000;
+#endif
 // clang-format on
 
 class UidRanges;
-- 
